function OnInit()
	print("lua OnInit")
end

function OnOpen()
	print("lua OnOpen")	

	local playmusic=self.transform:Find("playmusic"):GetComponent("Button")
	local playsound=self.transform:Find("playsound"):GetComponent("Button")
	local pause=self.transform:Find("pause"):GetComponent("Button")
	local unpause=self.transform:Find("unpause"):GetComponent("Button")
	local stop=self.transform:Find("stop"):GetComponent("Button")

	local musicslider=self.transform:Find("musicslider"):GetComponent("Slider")
	local soundslider=self.transform:Find("soundslider"):GetComponent("Slider")

	local pooltest=self.transform:Find("pooltest"):GetComponent("Button")
	local poolclose=self.transform:Find("poolclose"):GetComponent("Button")


	playmusic:OnClickSet(
		function()
			Manager.Sound:PlayMusic("dayu.mp3")			
		end
	)

	playsound:OnClickSet(
		function()
			Manager.Sound:PlaySound("ui_touch.wav")			
		end
	)

	pause:OnClickSet(
		function()
			Manager.Sound:PauseMusic()			
		end
	)

	unpause:OnClickSet(
		function()
			Manager.Sound:OnUnPauseMusic()			
		end
	)

	stop:OnClickSet(
		function()
			Manager.Sound:StopMusic()			
		end
	)

	musicslider:OnValueChangedSet(
		function(volume)
			Manager.Sound:SetMusicVolume(volume)		
		end
	)

	soundslider:OnValueChangedSet(
		function(volume)
			Manager.Sound:SetSoundVolume(volume)		
		end
	)

	musicslider.value=1;
	soundslider.value=1;

	pooltest:OnClickSet(
		function()
			Manager.UI:OpenUI("Test","UI","ui.TestUI")			
		end
	)

	poolclose:OnClickSet(
		function()
			self:OnClose()			
		end
	)
end

function OnClose()
	print("lua OnClose")
end

function Update()
	print("lua Update")
end